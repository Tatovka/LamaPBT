import Random;
import Array;
import List;
import STM;
import Collection;
import Fun;

fun max (x, y) { if x > y then x else y fi }


fun oneof (xs) {
    var k = xs.length;
    xs [random(k)]
}

fun invokeSt (st){
    fun (f) {
        f (st)
    }
}

fun forkSt (xs, fold) { 
    fun (st) {
        let [states, ys] = map (invokeSt(st), xs).unzip in
            [states.fold, ys]
    }
}

fun intGen(st) {
  [st, randomInt()]
}

fun intShrink(x) {
  [x / 2, 0, 1]
}

fun strGen (max_len) {
    fun (st) {
        [st, randomString(random(max_len))]
    }
}

fun strShrink(s) {
  [s[0], ""]
}

var noneGen = returnST (None);

fun extract (gen) {
    fun (st) {
        gen (st) [1]
    }
}

fun mul (types) {
    fun (st) {
        mapArray(invokeSt(st), types)
    }
}

fun mulShrink (shrinkers) {
    fun (xs) {
        initArray (xs.length, fun (x) { shrinkers[i] (xs[i]) } )
    }
}

fun either (types) {
    fun (st) {
        oneof(types)(st)
    }
}

fun eitherShrink (shrinkers) {
    fun (xs) {
        initArray (xs.length, fun (x) { shrinkers[i] (xs[i]) } )
    }
}

fun fix (f) {
    fun (st) {
        f (fix(f)) (st)
    } 
}

fun sized (f) {
    fun (n) {
        fun (st) {
            f (sized(f), n) (st)
        }
    } 
}

fun fix2 (f, g) {
    fun (st) {
        f (fix2(f, g), fix2(g, f)) (st)
    } 
}

fun sized2 (f, g) {
    fun (n) {
        fun (st) {
            f (sized2(f, g), sized2(g, f), n) (st)
        }
    } 
}

fun listFunc (f) {
    fun cons (x, xs) {
        fun () {
            Cons (x(), f())
        }
    }

    fun nil () {
        Nil
    }

    either ([nil, cons(mul([either([intGen, strGen(10)]), noneGen]), f)])
}

fun squeezeScheme(scheme) {
    fun rec(scheme) {
        case scheme of 
            Var(x) ->  fun (st@[m, k]) { case findMap(m, x) of Some(y) -> [st, Var (y)] | None -> [[addMap(m, x, k), k + 1], Var(k)] esac }
            | Not (x) -> rec(x) => fun (x) {Not(x)}
            | Or (x, y) -> rec(x) =>> fun (l) { rec (y) =>> fun (r) { returnST (Or (l, r)) }}
            | And (x, y) -> rec(x) =>> fun (l) { rec (y) =>> fun (r) { returnST (And (l, r)) }}
        esac
    }  
    case rec (scheme) ([emptyMap(fun (x, y) { x - y }), 0]) of 
        [[_, m], schemeNew] -> [m, schemeNew]
    esac
}

fun chain (n) {
    fun (l, r) {    
        let [n1, n2] = split (n, 2) in 
        chainST ({l(n1), r(n2)}) => listArray
    }
}

fun fork (n) {
    fun (l, r) { 
        let [n1, n2] = split (n, 2) in 
        forkSt ({l(n1), r(n2)}, fun (ss) { foldr (max, 0, ss) }) => listArray
    }
}

fun variable (st) {
    var x = st + random(10);
    [x + 1, Var (x)]
}

fun schemeFunctor (conj, disj) {
    fun (self, dual, n) {
        if n <= 1 then variable
        else either ([
            dual (n - 1)          => fun (x)      { Not (x) },
            conj (n) (self, self) => fun ([x, y]) { And (x, y) },
            disj (n) (self, self) => fun ([x, y]) { Or (x, y) }
        ]) fi
    }
}

var sat = extract $ sized2 (schemeFunctor (chain, fork), schemeFunctor (fork, chain))(10) => squeezeScheme;

printf("%s\n", sat(0).string)
