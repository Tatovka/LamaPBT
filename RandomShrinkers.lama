import Random;
import Array;
import List;
import STM;
import Collection;
import Fun;

public fun max (x, y) { if x > y then x else y fi }

public fun is (a, b) {
    case a of b -> true | _ -> false esac
}

public fun pack(x) { [x] }

public fun oneof (xs) {
    var k = xs.length;
    xs [random(k)]
}

-- {a -> b} -> {a} -> {b}
public fun app (fs, xs) {
    fun inner (fs, xs) {
        case fs of
            f : fs_ -> map (f, xs) : inner(fs_, xs)
            | {} -> {}
        esac
    }
    inner(fs, xs).flatten
}


-- (a -> {a}) -> {a} -> {{a}} 
public fun traverse (f, xs) {

    fun cons (x) {
        fun (l) {
            x : l
        }
    }

    case xs of 
        x:{} ->  map (fun (x) { {x} }, f (x))
        | x:xs_ -> map (cons, f (x)) .app (traverse (f, xs_) )
        | {} -> {}
    esac
}

public fun invokeSt (st){
    fun (f) {
        f (st)
    }
}
public fun invoke (f){
    f ()
}

public fun forkSt (xs, fold) { 
    fun (st) {
        let [states, ys] = map (invokeSt(st), xs).unzip in
            [states.fold, ys]
    }
}

public fun extract (gen) {
    fun (st) {
        gen (st) [1]
    }
}

public fun value ([a, b]) {
    a
}
public fun shrink ([a, b]) {
    b
}
public fun shrinkMb (xs) {
    oneof([xs, xs.shrink()])
}

public fun chainSTArray(arr) {
    chainST (arr.arrayList) => listArray
}

-- Gen a: s -> [s, [a, shrink a]]
-- shrink a: () -> oneof [(a, shrink a)]

public fun intGen(st) {
    var x = randomInt();
    printf("generated x = %d\n", x);
    [st, [x, intShrink(x)]]
}

fun intShrink(x) {
    fun () {
        oneof([
            [x / 2, intShrink(x / 2)], 
            [x / 5, intShrink(x / 5)], 
            [x / 10, intShrink(x / 10)]
        ])
    }
}

fun strShrink(s) {
  oneof([[s[0], strShrink], ["", emptyShrink]])
}

public fun emptyShrink () { [None, emptyShrink] }

public fun strGen (max_len) {
    fun (st) {
        [st, [randomString(random(max_len)), strShrink]]
    }
}

var noneGen = [returnST ([None, emptyShrink])];

fun mulShrinkSequence(xs) { -- [(a, shrink a)] -> ([a], shrink [a])
    [mapArray(value, xs), mapArray(shrink, xs).mulShrink]
}

public fun mul (types) {
    chainSTArray (types) => mulShrinkSequence
}

fun mulShrink (shrinkers) { -- [shrink a] -> shrink [a]
    fun () {-- () -> ([a], shrink [a])
        var shrinked = mapArray(invoke, shrinkers); -- shrinked : [(a, shrink a)]
        mulShrinkSequence(shrinked)
    }
}

public fun either (types) {
    fun (st) {
        oneof(types)(st)
    }
}

public fun fixPoint (f, sh) {
    fun (st) {
        f (fixPoint(f)) (st)
    } 
}

public fun sized (f) {
    fun (n) {
        fun (st) {
            f (sized(f), n) (st)
        }
    } 
}

public fun fix2 (f, g) {
    fun (st) {
        f (fix2(f, g), fix2(g, f)) (st)
    } 
}

public fun sized2 (f, g) {
    fun (n) {
        fun (st) {
            f (sized2(f, g), sized2(g, f), n) (st)
        }
    } 
}

public fun mapValShrink(f) { fun ([value, shrink]) {
    [f (value), fun () { mapValShrink(f) (shrink()) }]
}}

public fun idShrink(v) {
    fun () {
        [v, idShrink(v)]
    }
}

-- f ([x_1, ..., x_n])
-- shrink f ([x_1, ..., x_n]) = f ([shrink x_1, ..., shrink x_n])
public fun wrapShrink(f, children) {
    fun () {
        var shrinked = mapArray(fun ([_, shrinkGen]) { shrinkGen() }, children);
        var values = mapArray( fun ([x, _]) { x }, shrinked ); 
        [f (values), wrapShrink(f, shrinked)]
    }
}

-- C([x_1,x_2,...,x_n])
-- shrink C([x_1,x_2,...,x_n]) = C ([shrink? x_1, shrink? x_2, ..., shrink? x_n]) | either [shrink? x_1, shrink? x_2, ..., shrink? x_n]) 
public fun treeShrink(constr, children) {
    fun () {
        var inners = mapArray(shrinkMb, children);
        if (random(2) == 0) then
            oneof(inners)
        else
            [constr (mapArray (value, inners)), treeShrink(constr, inners)]
        fi
    }
}

public fun construct(constructor, shrinker) {
    fun (children) {
        [constructor (mapArray (value, children)), shrinker(constructor, children)]
    }
}

public fun leaf(v) {
    idShrink(v)()
}


fun tryShrink([old, gen], fn, ans, cnt, d) {
    var res = NF;
    if d <= 0 then old else
        var i; for i := 0, i < cnt && res.is(NF), i := i + 1 do
            var x = gen();
            if fn (x.value) != ans then 
                res := tryShrink(x, fn, ans, cnt, d - 1)
            fi
        od;
        case res of NF -> old | _ -> res esac
    fi
}

public fun runTests(gen, fn, cnt) {
    var i; for i := 0, i < cnt, i := i + 1 do
        printf("--- running test %d ---\n", i + 1);
        let [[test, shrinkGen], ans] = gen () in 
             if fn (test) == ans then printf("succeed\n") 
             else 
                printf("failed at: %s\n", test.string); 
                printf("minimal countrexample: %s\n", tryShrink([test, shrinkGen], fn, ans, 10, 5).string ) 
             fi
    od
}
