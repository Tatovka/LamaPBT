fun runTests(gen, fn, cnt) {
    var i; for i := 0, i < cnt, i := i + 1 do
        printf("test %d ", i + 1);
        case gen () of 
            [test, ans] -> printf(if fn (test) == ans then "succeed\n" else "failed\n" fi)
        esac
    od
}


runTests(
    fun () { generateSchemeSat (10, 3) }, 
    fun (scheme) { var sq = squeezeScheme(scheme); runSolver(sq[1], sq[0]) }, 
    10
)