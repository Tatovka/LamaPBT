        }
    },
    --case2
    fun (mode, depth, rec) {
        var inners = mapArray (rec.curry $ mode, split (depth, 2));
        inners[0] =>> fun (l) { inners[1] =>> fun (r) { returnST (constructors[1 - mode] (l, r)) }}
    },
    --baseState
    0
);

